RewriteRule ^en/security-services/advanced-security/site-security/?$ https://securitycontrol.nl/en/services/site-security/ [R=301,L]
RewriteRule ^en/security-services/advanced-security/event-security/?$ https://securitycontrol.nl/en/services/event-security/ [R=301,L]
RewriteRule ^en/security-services/advanced-security/dog-security/?$ https://securitycontrol.nl/en/services/security-dogs/ [R=301,L]
RewriteRule ^en/security-services/advanced-security/fireguards/?$ https://securitycontrol.nl/en/services/fire-watch/ [R=301,L]
RewriteRule ^en/security-services/advanced-security/equipment/?$ https://securitycontrol.nl/en/services/security-equipment/ [R=301,L]
RewriteRule ^en/security-services/training-services/driving-courses/?$ https://securitycontrol.nl/en/services/protective-driving/ [R=301,L]
