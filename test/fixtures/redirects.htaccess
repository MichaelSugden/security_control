# 301s from the live v1 paths to the v2 URLs (URL map, section 2). Exact match, one hop.
RewriteEngine On
RewriteRule ^en/security-services/?$ https://securitycontrol.nl/en/services/ [R=301,L]
RewriteRule ^en/security-services/specialised-security/?$ https://securitycontrol.nl/en/services/specialised-security/ [R=301,L]
RewriteRule ^en/security-services/advanced-security/?$ https://securitycontrol.nl/en/services/advanced-security/ [R=301,L]
RewriteRule ^en/security-services/training-services/?$ https://securitycontrol.nl/en/services/security-training/ [R=301,L]
