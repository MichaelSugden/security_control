# Gone: answer 410 unless the client publishes these pages
RewriteRule ^(nl/)?algemene-voorwaarden/?$ - [G,L]
RewriteRule ^(nl/)?sample/?$ - [G,L]
RewriteRule ^(nl/)?project/?$ - [G,L]
