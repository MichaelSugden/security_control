RewriteRule ^nl/security-services/advanced-security/dog-security/?$ https://securitycontrol.nl/nl/diensten/beveiligingshond/ [R=301,L]
RewriteRule ^nl/security-services/advanced-security/fireguards/?$ https://securitycontrol.nl/nl/diensten/brandwacht/ [R=301,L]
RewriteRule ^nl/security-services/advanced-security/equipment/?$ https://securitycontrol.nl/nl/diensten/beveiligingsmiddelen/ [R=301,L]
