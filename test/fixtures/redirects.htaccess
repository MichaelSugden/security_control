# Legacy 2020 site, root level and /nl/
RewriteRule ^contact/?$ https://securitycontrol.nl/nl/contact/ [R=301,L]
RewriteRule ^security-services/?$ https://securitycontrol.nl/nl/diensten/ [R=301,L]
RewriteRule ^family-security-programme/?$ https://securitycontrol.nl/nl/diensten/familiebeveiliging/ [R=301,L]
